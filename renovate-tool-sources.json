{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^(oci|check|lint|workflow|maintenance)/.*Containerfile$/", "/^shared/runtime/compile-[a-z]+\\.sh$/"],
      "matchStrings": ["compile-tool\\.sh\\s+(?<depName>(?:github\\.com|golang\\.org|google\\.golang\\.org|go\\.podman\\.io|oras\\.land)/[a-zA-Z0-9_./-]+)\\s+(?<currentValue>v[0-9][a-zA-Z0-9.+-]*)\\s+h1:[A-Za-z0-9+/]{43}="],
      "datasourceTemplate": "go",
      "versioningTemplate": "gomod",
      "depTypeTemplate": "tool-source"
    }
  ],
  "packageRules": [
    {
      "description": "Keep public Go source versions and verified module checksums together",
      "matchManagers": ["custom.regex"],
      "matchDepTypes": ["tool-source"],
      "postUpgradeTasks": {
        "commands": ["/usr/local/bin/update-tool-checksums"],
        "fileFilters": ["{oci,check,lint,workflow,maintenance}/*/Containerfile", "shared/runtime/compile-*.sh"],
        "executionMode": "branch"
      }
    }
  ]
}
