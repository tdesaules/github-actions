FROM quay.io/fedora/fedora:45@sha256:fa773d10382c082ff2cccaf7982a5c162f11f296f91274b994357f2d3d473770 AS build
# hadolint ignore=DL3041
RUN dnf install -y golang-1.27.3-1.fc45 ca-certificates && dnf clean all
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY go.mod go.sum ./
COPY shared/check/ ./shared/check/
COPY lint/actionlint/main.go ./lint/actionlint/main.go
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /entrypoint ./lint/actionlint
COPY shared/runtime/compile-tool.sh /compile-tool.sh
RUN sh /compile-tool.sh github.com/rhysd/actionlint v1.7.12 h1:vQ4GeJN86C0QH+gTUQcs8McmK62OLT3kmakPMtEWYnY= actionlint

FROM scratch AS final
COPY LICENSE /usr/share/licenses/github-actions/LICENSE
COPY --from=build /entrypoint /entrypoint
COPY --from=build /tool /usr/bin/actionlint
COPY --from=build /runtime/ /
COPY --from=build /tool-source/LICENSE.txt /usr/share/licenses/actionlint/LICENSE
# Entrypoint adopts the runner-owned GITHUB_OUTPUT UID before checking files.
# hadolint ignore=DL3002
USER 0:0
WORKDIR /github/workspace
ENTRYPOINT ["/entrypoint"]
LABEL org.opencontainers.image.title="check-test-github-workflow" org.opencontainers.image.source="https://github.com/tdesaules/github-actions" org.opencontainers.image.licenses="GPL-3.0-only AND MIT"
