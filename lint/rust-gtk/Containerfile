FROM quay.io/fedora/fedora:45@sha256:fd31d2f9dfd835cf7398af9cb6cbbbffbd33ffac2d5204042ea14157455b63a2 AS build
# hadolint ignore=DL3041
RUN dnf install -y golang-1.27.3-1.fc45 && dnf clean all
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY go.mod go.sum ./
COPY shared/workflow/ ./shared/workflow/
COPY shared/rustgtk/ ./shared/rustgtk/
COPY lint/rust-gtk/main.go ./lint/rust-gtk/main.go
RUN CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /entrypoint ./lint/rust-gtk

FROM quay.io/fedora/fedora:44@sha256:5aae8bdc5f40bf70f8f189a70770e6f1fabcb04976e841262431c3bbfdbe3538 AS final
# Packaged compiler and GTK headers are required by Clippy; never bootstrap rustup.
# hadolint ignore=DL3041
RUN dnf install -y --setopt=install_weak_deps=False rust-1.99.1-2.fc44 cargo-1.99.1-2.fc44 rustfmt-1.99.1-2.fc44 clippy-1.99.1-2.fc44 gcc gtk4-devel pkgconf-pkg-config nodejs22 nodejs22-bin nodejs22-npm nodejs22-npm-bin python3 desktop-file-utils git ca-certificates \
    && dnf clean all
COPY --from=build /entrypoint /entrypoint
COPY LICENSE /usr/share/licenses/github-actions/LICENSE
ENV PYTHONDONTWRITEBYTECODE=1
WORKDIR /github/workspace
ENTRYPOINT ["/entrypoint"]
LABEL org.opencontainers.image.title="lint-rust-gtk" org.opencontainers.image.source="https://github.com/tdesaules/github-actions" org.opencontainers.image.licenses="GPL-3.0-only"
