{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "docker:pinDigests", "helpers:pinGitHubActionDigests"],
  "dependencyDashboard": true,
  "automerge": false,
  "platformCommit": "disabled",
  "logLevelRemap": [
    {
      "matchMessage": "/Caught error setting branch status - aborting/",
      "newLogLevel": "warn"
    },
    {
      "matchMessage": "/Executed post-upgrade task/",
      "newLogLevel": "info"
    }
  ],
  "packageRules": [
    {
      "description": "Keep catalog builds on Fedora 45; upstream digest retention is not guaranteed",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["quay.io/fedora/fedora", "quay.io/fedora/fedora-minimal"],
      "pinDigests": false,
      "allowedVersions": "/^45$/"
    },
    {
      "description": "Preserve the Fedora 44 ABI of the Rust/GTK consumer runtime stages",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["quay.io/fedora/fedora"],
      "matchFileNames": ["lint/rust-gtk/Containerfile", "workflow/build-rust-gtk/Containerfile", "workflow/test-rust-gtk/Containerfile"],
      "matchCurrentValue": "44",
      "allowedVersions": "/^44$/"
    },
    {
      "description": "Catalogue-owned digest-only images are updated by verified publication, not upstream version discovery",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/tdesaules/github-actions/**"],
      "enabled": false
    }
  ],
  "enabledManagers": ["dockerfile", "github-actions", "gomod", "npm", "custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^(oci|check|lint|workflow|maintenance)/.*Containerfile$/", "/^shared/runtime/compile-[a-z]+\\.sh$/"],
      "matchStrings": ["(?<depName>(?:github\\.com|golang\\.org|google\\.golang\\.org|go\\.podman\\.io|go\\.opentelemetry\\.io)/[a-zA-Z0-9_./-]+)@(?<currentValue>v[0-9][a-zA-Z0-9.+-]*)"],
      "datasourceTemplate": "go"
    }
  ]
}
