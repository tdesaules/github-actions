FROM docker.io/library/golang:1.27.4-alpine3.24@sha256:0a5f7fe796599ff487605987432e7619ae45beeb2fba4c2ce0b907879932aebf AS build
WORKDIR /src
COPY go.mod go.sum ./
COPY shared/workflow/ ./shared/workflow/
COPY oci/publish-artifact/ ./oci/publish-artifact/
RUN CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /entrypoint ./oci/publish-artifact \
    && mkdir -p /runtime/tmp && chmod 1777 /runtime/tmp
FROM docker.io/library/golang:1.27.4-alpine3.24@sha256:0a5f7fe796599ff487605987432e7619ae45beeb2fba4c2ce0b907879932aebf AS oras
COPY shared/runtime/compile-tool.sh /compile-tool.sh
COPY shared/runtime/compile-oras.sh /compile-oras.sh
RUN sh /compile-oras.sh
FROM scratch AS final
COPY LICENSE /usr/share/licenses/github-actions/LICENSE
COPY --from=build /runtime/ /
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /entrypoint /entrypoint
COPY --from=oras /tool /usr/bin/oras
COPY --from=oras /runtime/usr/share/licenses/oras/ /usr/share/licenses/oras/
ENV PATH=/usr/bin HOME=/tmp
WORKDIR /github/workspace
ENTRYPOINT ["/entrypoint"]
LABEL org.opencontainers.image.title="oci-publish-artifact" org.opencontainers.image.source="https://github.com/tdesaules/github-actions" org.opencontainers.image.licenses="GPL-3.0-only"
