FROM docker.io/library/golang:1.27.3-alpine3.24@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb AS entrypoint
WORKDIR /src
COPY go.mod ./
COPY shared/runtime/ ./shared/runtime/
COPY oci/build-image/main.go ./oci/build-image/main.go
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /entrypoint ./oci/build-image

FROM entrypoint AS tool
# Build-only C toolchain for the namespace constructor, statically linked with musl.
# hadolint ignore=DL3018
RUN apk add --no-cache gcc linux-headers musl-dev
# Cache the C toolchain independently from the upstream module build.
# hadolint ignore=DL3059
RUN BUILDTAGS=containers_image_openpgp,exclude_graphdriver_btrfs,exclude_graphdriver_devicemapper sh shared/runtime/compile-tool.sh github.com/containers/buildah v1.43.4 h1:49Wha4/df1+q8DXN8jjT2oGO8jF19eRsGA7dvMP2UH0= buildah golang.org/x/net@v0.60.0 golang.org/x/mod@v0.40.0 google.golang.org/grpc@v1.83.1 go.opentelemetry.io/otel@v1.41.0 github.com/moby/buildkit@v0.28.1 github.com/moby/go-archive@v0.3.0 github.com/sigstore/fulcio@v1.8.6

FROM quay.io/buildah/stable:v1.43.4@sha256:07e637ad7a1df37f44afea8287935b350224ac193d63e5cc96debb50a366853c AS runtime
COPY --from=tool /tool /usr/bin/buildah
COPY shared/runtime/collect-runtime.sh /collect-runtime.sh
RUN sh /collect-runtime.sh buildah

FROM scratch AS final
COPY LICENSE /usr/share/licenses/github-actions/LICENSE
COPY --from=runtime /runtime/ /
COPY --from=entrypoint /entrypoint /entrypoint
ENV PATH=/usr/bin SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt HOME=/tmp BUILDAH_ISOLATION=chroot STORAGE_DRIVER=vfs
# Root inside the container is required for chroot; the outer engine may be rootless.
# hadolint ignore=DL3002
USER 0:0
WORKDIR /github/workspace
ENTRYPOINT ["/entrypoint"]
LABEL org.opencontainers.image.title="oci-build-image" org.opencontainers.image.source="https://github.com/tdesaules/github-actions" org.opencontainers.image.licenses="GPL-3.0-only AND Apache-2.0"
