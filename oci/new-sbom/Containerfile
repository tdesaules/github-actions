FROM quay.io/fedora/fedora:45@sha256:fd31d2f9dfd835cf7398af9cb6cbbbffbd33ffac2d5204042ea14157455b63a2 AS entrypoint
# hadolint ignore=DL3041
RUN dnf install -y golang-1.27.3-1.fc45 ca-certificates && dnf clean all
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY go.mod ./
COPY shared/runtime/ ./shared/runtime/
COPY oci/new-sbom/main.go ./oci/new-sbom/main.go
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /entrypoint ./oci/new-sbom

FROM entrypoint AS upstream
RUN sh shared/runtime/compile-syft.sh

FROM scratch AS final
COPY LICENSE /usr/share/licenses/github-actions/LICENSE
COPY --from=upstream /tool /usr/bin/syft
COPY --from=entrypoint /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=upstream /runtime/ /
COPY --from=upstream /tool-source/LICENSE /usr/share/licenses/syft/LICENSE
COPY --from=entrypoint /entrypoint /entrypoint
ENV PATH=/usr/bin HOME=/tmp SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt SYFT_CHECK_FOR_APP_UPDATE=false
# Entrypoint adopts the runner UID for writable bind mounts.
# hadolint ignore=DL3002
USER 0:0
WORKDIR /github/workspace
ENTRYPOINT ["/entrypoint"]
LABEL org.opencontainers.image.title="oci-new-sbom" org.opencontainers.image.source="https://github.com/tdesaules/github-actions" org.opencontainers.image.licenses="GPL-3.0-only AND Apache-2.0"
