FROM docker.io/library/golang:1.27.3-alpine3.24@sha256:fa3d596898d9f126af7c01d14ee7597bab3f39cccf392ef36b69fe77cd681f18 AS build
WORKDIR /src
COPY go.mod go.sum ./
COPY shared/workflow/ ./shared/workflow/
COPY shared/pantavisor/ ./shared/pantavisor/
COPY shared/component/ ./shared/component/
COPY oci/publish-component/main.go ./oci/publish-component/main.go
RUN CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /entrypoint ./oci/publish-component \
    && mkdir -p /runtime/tmp && chmod 1777 /runtime/tmp
FROM docker.io/library/golang:1.27.3-alpine3.24@sha256:fa3d596898d9f126af7c01d14ee7597bab3f39cccf392ef36b69fe77cd681f18 AS oras
COPY shared/runtime/compile-tool.sh /compile-tool.sh
COPY shared/runtime/compile-oras.sh /compile-oras.sh
RUN sh /compile-oras.sh
FROM scratch AS final
COPY LICENSE /usr/share/licenses/github-actions/LICENSE
COPY --from=build /runtime/ /
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /entrypoint /entrypoint
COPY --from=oras /tool /usr/bin/oras
COPY --from=oras /runtime/usr/share/licenses/oras/ /usr/share/licenses/oras/
ENV PATH=/usr/bin HOME=/tmp
# Writes only GITHUB_OUTPUT and an ephemeral private auth/layout directory.
# hadolint ignore=DL3002
USER 0:0
WORKDIR /github/workspace
ENTRYPOINT ["/entrypoint"]
LABEL org.opencontainers.image.title="oci-publish-component" org.opencontainers.image.source="https://github.com/tdesaules/github-actions" org.opencontainers.image.licenses="GPL-3.0-only"
