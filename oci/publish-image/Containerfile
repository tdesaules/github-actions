FROM docker.io/library/golang:1.27.2-alpine3.24@sha256:f92b6ef800e499660581efdabdf25d9d817a9d124eaf900924f0504e7e27e12d AS entrypoint
WORKDIR /src
COPY go.mod ./
COPY shared/runtime/ ./shared/runtime/
COPY oci/publish-image/main.go ./oci/publish-image/main.go
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /entrypoint ./oci/publish-image

FROM entrypoint AS tool
RUN BUILDTAGS=containers_image_openpgp,exclude_graphdriver_btrfs,exclude_graphdriver_devicemapper sh shared/runtime/compile-tool.sh github.com/containers/skopeo v1.22.3 h1:r85TJYmaMhSgmtuPWxrsPQgaWL/+Q3y/cLLGE/DXjlc= skopeo golang.org/x/net@v0.60.0 golang.org/x/crypto@v0.56.0 golang.org/x/text@v0.41.0 google.golang.org/grpc@v1.83.1 go.opentelemetry.io/otel@v1.41.0 github.com/opencontainers/selinux@v1.13.0 github.com/sigstore/fulcio@v1.8.6

FROM ghcr.io/tdesaules/github-actions/oci-import-image@sha256:11f4439932710275ca5ffce92e71eef3680e09907c99c2eb0b83dfd32ebbdba1 AS runtime

FROM scratch AS final
COPY LICENSE /usr/share/licenses/github-actions/LICENSE
COPY --from=runtime /etc/ /etc/
COPY --from=runtime /tmp/ /tmp/
COPY --from=runtime /var/ /var/
COPY --from=runtime /run/ /run/
COPY --from=tool /tool /usr/bin/skopeo
COPY --from=entrypoint /entrypoint /entrypoint
ENV PATH=/usr/bin SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt HOME=/tmp
# OCI archive extraction preserves ownership and requires container root.
# hadolint ignore=DL3002
USER 0:0
WORKDIR /github/workspace
ENTRYPOINT ["/entrypoint"]
LABEL org.opencontainers.image.title="oci-publish-image" org.opencontainers.image.source="https://github.com/tdesaules/github-actions" org.opencontainers.image.licenses="GPL-3.0-only AND Apache-2.0"
