FROM docker.io/library/golang:1.27.2-alpine3.24@sha256:f92b6ef800e499660581efdabdf25d9d817a9d124eaf900924f0504e7e27e12d AS entrypoint
WORKDIR /src
COPY go.mod ./
COPY shared/runtime/ ./shared/runtime/
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w -X main.tool=cosign' -o /entrypoint ./shared/runtime

FROM entrypoint AS upstream
RUN sh shared/runtime/compile-tool.sh github.com/sigstore/cosign/v3 v3.1.3 h1:001JQRI/PJ/5T+g/kJ1KTvKFbb322+fomc+pHDZ/6sg= cosign golang.org/x/net@v0.60.0 golang.org/x/crypto@v0.56.0 golang.org/x/text@v0.41.0 golang.org/x/mod@v0.40.0 google.golang.org/grpc@v1.83.1

FROM scratch AS final
COPY LICENSE /usr/share/licenses/github-actions/LICENSE
COPY --from=upstream /tool /usr/bin/cosign
COPY --from=entrypoint /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=upstream /runtime/ /
COPY --from=entrypoint /entrypoint /entrypoint
ENV PATH=/usr/bin HOME=/tmp SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
# Entrypoint adopts the runner UID for writable bind mounts.
# hadolint ignore=DL3002
USER 0:0
WORKDIR /github/workspace
ENTRYPOINT ["/entrypoint"]
LABEL org.opencontainers.image.title="Cosign Docker action" org.opencontainers.image.source="https://github.com/tdesaules/github-actions" org.opencontainers.image.licenses="GPL-3.0-only AND Apache-2.0"
