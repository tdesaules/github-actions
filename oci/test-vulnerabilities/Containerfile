FROM docker.io/library/golang:1.27.3-alpine3.24@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb AS entrypoint
WORKDIR /src
COPY go.mod ./
COPY shared/runtime/ ./shared/runtime/
COPY oci/test-vulnerabilities/main.go ./oci/test-vulnerabilities/main.go
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /entrypoint ./oci/test-vulnerabilities

FROM entrypoint AS upstream
RUN sh shared/runtime/compile-tool.sh github.com/anchore/grype v0.120.1 h1:kaO5Vudd1jmjFNYJoOro7AIg10cjrKAy71ZaOFdX0js= grype golang.org/x/net@v0.60.0

FROM scratch AS final
COPY LICENSE /usr/share/licenses/github-actions/LICENSE
COPY --from=upstream /tool /usr/bin/grype
COPY --from=entrypoint /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=upstream /runtime/ /
COPY --from=entrypoint /entrypoint /entrypoint
ENV PATH=/usr/bin HOME=/tmp SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt GRYPE_CHECK_FOR_APP_UPDATE=false GRYPE_DB_CACHE_DIR=/tmp/grype-db
# Entrypoint adopts the runner UID for writable bind mounts.
# hadolint ignore=DL3002
USER 0:0
WORKDIR /github/workspace
ENTRYPOINT ["/entrypoint"]
LABEL org.opencontainers.image.title="oci-test-vulnerabilities" org.opencontainers.image.source="https://github.com/tdesaules/github-actions" org.opencontainers.image.licenses="GPL-3.0-only AND Apache-2.0"
