FROM quay.io/fedora/fedora:44@sha256:17c99e30075386f9385685a22ad1924e2c22faee5863272c0379c81b80b9d258 AS build
# Supporting RPMs follow the signed Fedora repository; the Go compiler is pinned.
# hadolint ignore=DL3041
RUN dnf install -y golang-1.26.10-1.fc44 git ca-certificates && dnf clean all
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY go.mod go.sum ./
COPY shared/catalog/ ./shared/catalog/
COPY shared/review/ ./shared/review/
COPY shared/workflow/ ./shared/workflow/
COPY maintenance/test-catalog-vulnerabilities/main.go ./maintenance/test-catalog-vulnerabilities/main.go
RUN CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /entrypoint ./maintenance/test-catalog-vulnerabilities
FROM build AS patched-grype
COPY shared/runtime/ ./shared/runtime/
RUN sh shared/runtime/compile-grype.sh
FROM scratch AS final
COPY LICENSE /usr/share/licenses/github-actions/LICENSE
COPY --from=patched-grype /runtime/ /
COPY --from=patched-grype /tool-source/LICENSE /usr/share/licenses/grype/LICENSE
COPY --from=build /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem /etc/ssl/certs/ca-certificates.crt
COPY --from=patched-grype /tool /usr/bin/grype
COPY --from=build /entrypoint /entrypoint
ENV PATH=/usr/bin HOME=/tmp
# Writes reports and the database into the runner workspace.
# hadolint ignore=DL3002
USER 0:0
WORKDIR /github/workspace
ENTRYPOINT ["/entrypoint"]
LABEL org.opencontainers.image.title="maintenance-test-catalog-vulnerabilities" org.opencontainers.image.source="https://github.com/tdesaules/github-actions" org.opencontainers.image.licenses="GPL-3.0-only AND Apache-2.0"
