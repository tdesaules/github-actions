FROM quay.io/fedora/fedora:45@sha256:fd31d2f9dfd835cf7398af9cb6cbbbffbd33ffac2d5204042ea14157455b63a2 AS build
# hadolint ignore=DL3041
RUN dnf install -y golang-1.27.3-1.fc45 ca-certificates && dnf clean all
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY go.mod go.sum ./
COPY maintenance/update-dependencies/main.go ./maintenance/update-dependencies/main.go
COPY maintenance/update-dependencies/checksums/main.go ./maintenance/update-dependencies/checksums/main.go
RUN CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /entrypoint ./maintenance/update-dependencies \
    && CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /update-tool-checksums ./maintenance/update-dependencies/checksums

FROM quay.io/fedora/fedora:45@sha256:fd31d2f9dfd835cf7398af9cb6cbbbffbd33ffac2d5204042ea14157455b63a2 AS dependencies
# hadolint ignore=DL3041
RUN dnf install -y nodejs24-24.18.0-4.fc45 nodejs24-npm ca-certificates && dnf clean all \
    && ln -s /usr/bin/node-24 /usr/local/bin/node \
    && ln -s /usr/bin/npm-24 /usr/local/bin/npm
WORKDIR /deps
COPY maintenance/update-dependencies/dependencies.undici/package.json maintenance/update-dependencies/dependencies.undici/package-lock.json ./
RUN npm ci --ignore-scripts --omit=dev --no-audit --no-fund
WORKDIR /npm-runtime
COPY maintenance/update-dependencies/dependencies.npm/package.json maintenance/update-dependencies/dependencies.npm/package-lock.json ./
COPY maintenance/update-dependencies/update-npm.cjs /update-npm.cjs
RUN npm ci --ignore-scripts --omit=dev --no-audit --no-fund \
    && node /update-npm.cjs

FROM dependencies AS tool
# Compile the optional RE2 acceleration against the same distro Node ABI.
# hadolint ignore=DL3041
RUN dnf install -y nodejs24-devel-24.18.0-4.fc45 gcc-c++ make python3 && dnf clean all
WORKDIR /renovate-install
COPY maintenance/update-dependencies/dependencies.renovate/package.json maintenance/update-dependencies/dependencies.renovate/package-lock.json ./
RUN npm ci --ignore-scripts --omit=dev --no-audit --no-fund
WORKDIR /renovate-install/node_modules/re2
RUN npm_config_nodedir=/usr ../.bin/node-gyp rebuild --jobs 2
WORKDIR /renovate-install
RUN mkdir -p /usr/local/renovate \
    && cp -a node_modules/renovate/. /usr/local/renovate/ \
    && rm -rf node_modules/renovate \
    && cp -a node_modules /usr/local/renovate/ \
    && ln -s /usr/bin/node-24 /usr/local/renovate/node
COPY maintenance/update-dependencies/patch-braces.cjs /patch-braces.cjs
COPY --from=dependencies /deps/node_modules/ /usr/local/renovate/undici-fixed/node_modules/
COPY maintenance/update-dependencies/update-undici.cjs /update-undici.cjs
RUN /usr/local/renovate/node /patch-braces.cjs \
    && /usr/local/renovate/node /update-undici.cjs

FROM quay.io/fedora/fedora:45@sha256:fd31d2f9dfd835cf7398af9cb6cbbbffbd33ffac2d5204042ea14157455b63a2 AS final
# Renovate needs a maintained Node, Git/HTTPS, shell and Go environment.
# Retain the distro's runtime closure, RPM metadata, trust roots and licenses.
# hadolint ignore=DL3041
RUN dnf install -y --setopt=install_weak_deps=False nodejs24-24.18.0-4.fc45 git golang-1.27.3-1.fc45 bash ca-certificates && dnf clean all \
    && ln -s /usr/bin/node-24 /usr/local/bin/node \
    && ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
COPY LICENSE /usr/share/licenses/github-actions/LICENSE
COPY --from=tool /usr/local/renovate/ /usr/local/renovate/
COPY --from=dependencies /npm-runtime/node_modules/npm/ /usr/local/lib/node_modules/npm/
COPY --from=build /entrypoint /entrypoint
COPY --from=build /update-tool-checksums /usr/local/bin/update-tool-checksums
COPY renovate-tool-sources.json /etc/renovate/tool-sources.json
ENV PATH=/usr/local/bin:/usr/bin:/bin HOME=/tmp GOCACHE=/tmp/go-cache GOPATH=/tmp/go SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt CGO_ENABLED=0 GOTOOLCHAIN=local
USER 65532:65532
WORKDIR /tmp
ENTRYPOINT ["/entrypoint"]
LABEL org.opencontainers.image.title="maintenance-update-dependencies" org.opencontainers.image.source="https://github.com/tdesaules/github-actions" org.opencontainers.image.licenses="GPL-3.0-only AND AGPL-3.0-only"
