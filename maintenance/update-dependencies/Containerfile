FROM docker.io/library/golang:1.27.3-alpine3.24@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb AS build
WORKDIR /src
COPY go.mod go.sum ./
COPY maintenance/update-dependencies/main.go ./maintenance/update-dependencies/main.go
RUN CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /entrypoint ./maintenance/update-dependencies

FROM docker.io/library/node:24-alpine@sha256:6a1c190e17215d844926b0677f4bf87273ff7d5e54db06d3b5b5863ab0b09a3d AS dependencies
WORKDIR /deps
COPY maintenance/update-dependencies/dependencies.undici/package.json maintenance/update-dependencies/dependencies.undici/package-lock.json ./
RUN npm ci --ignore-scripts --omit=dev --no-audit --no-fund

FROM ghcr.io/renovatebot/renovate:44.181.6@sha256:aa5593807ecc64295edba8085d75f36f27c82b47e3baf77061108ff6e2f2024b AS tool
# Runtime assembly needs to create /runtime in this intermediate stage.
# hadolint ignore=DL3002
USER 0:0
COPY shared/collect-binaries.sh /collect-binaries.sh
COPY maintenance/update-dependencies/patch-braces.cjs /patch-braces.cjs
COPY --from=dependencies /deps/node_modules/ /usr/local/renovate/undici-fixed/node_modules/
COPY maintenance/update-dependencies/update-undici.cjs /update-undici.cjs
RUN /usr/local/renovate/node /patch-braces.cjs \
    && /usr/local/renovate/node /update-undici.cjs \
    && sh /collect-binaries.sh /usr/local/renovate/node /usr/bin/git /bin/sh /usr/bin/bash /usr/bin/env /usr/lib/git-core/git-remote-http

FROM scratch AS final
COPY LICENSE /usr/share/licenses/github-actions/LICENSE
COPY --from=tool /runtime/ /
COPY --from=tool /usr/local/renovate/ /usr/local/renovate/
COPY --from=tool /usr/lib/git-core/ /usr/lib/git-core/
# Go is a runtime dependency of Renovate's gomod artifact updates.
COPY --from=build /usr/local/go/ /usr/local/go/
COPY --from=build /entrypoint /entrypoint
ENV PATH=/usr/local/go/bin:/usr/bin:/bin HOME=/tmp GOCACHE=/tmp/go-cache GOPATH=/tmp/go SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt CGO_ENABLED=0
USER 65532:65532
WORKDIR /tmp
ENTRYPOINT ["/entrypoint"]
LABEL org.opencontainers.image.title="maintenance-update-dependencies" org.opencontainers.image.source="https://github.com/tdesaules/github-actions" org.opencontainers.image.licenses="GPL-3.0-only AND AGPL-3.0-only"
