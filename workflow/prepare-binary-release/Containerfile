FROM quay.io/fedora/fedora:44@sha256:102f5031dc46ed1975bd2cd98bdf19c59617f3f0026310022f3cb680abe056d3 AS build
# hadolint ignore=DL3041
RUN dnf install -y golang-1.26.10-1.fc44 curl tar gzip && dnf clean all
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY go.mod go.sum ./
COPY shared/binaryrelease/ ./shared/binaryrelease/
COPY workflow/prepare-binary-release/main.go ./workflow/prepare-binary-release/main.go
RUN CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /entrypoint ./workflow/prepare-binary-release
# Verified upstream release checksums reused from workflow/complete-release.
RUN case "$(uname -m)" in \
    x86_64) target=x86_64; sum=fa21e2fc70046fcfd0e43e5e4613873ab799aff3d9dc8559c00d31b270e417d0 ;; \
    aarch64) target=aarch64; sum=4be21b21ec9699af4d330b224aeba8a41d41d8f5b351ca2da8a9ea2bdc36380f ;; \
    *) exit 1 ;; esac \
    && curl --fail --location --retry 3 "https://github.com/orhun/git-cliff/releases/download/v2.14.2/git-cliff-2.14.2-${target}-unknown-linux-musl.tar.gz" -o /tmp/cliff.tar.gz \
    && printf '%s  /tmp/cliff.tar.gz\n' "$sum" > /tmp/cliff.sha256 \
    && sha256sum -c /tmp/cliff.sha256 \
    && mkdir /cliff && tar -xzf /tmp/cliff.tar.gz --strip-components=1 -C /cliff
FROM quay.io/fedora/fedora:44@sha256:102f5031dc46ed1975bd2cd98bdf19c59617f3f0026310022f3cb680abe056d3 AS final
# Atomic git push and git-cliff retain their distribution runtime.
# hadolint ignore=DL3041
RUN dnf install -y --setopt=install_weak_deps=False git ca-certificates && dnf clean all
COPY LICENSE /usr/share/licenses/github-actions/LICENSE
COPY --from=build /cliff/git-cliff /usr/local/bin/git-cliff
COPY --from=build /cliff/LICENSE-APACHE /usr/share/licenses/git-cliff/LICENSE-APACHE
COPY --from=build /cliff/LICENSE-MIT /usr/share/licenses/git-cliff/LICENSE-MIT
COPY --from=build /entrypoint /entrypoint
ENV PATH=/usr/local/bin:/usr/bin:/bin HOME=/tmp GIT_TERMINAL_PROMPT=0
# Commits only validated release metadata in the runner checkout.
# hadolint ignore=DL3002
USER 0:0
WORKDIR /github/workspace
ENTRYPOINT ["/entrypoint"]
LABEL org.opencontainers.image.title="workflow-prepare-binary-release" org.opencontainers.image.source="https://github.com/tdesaules/github-actions" org.opencontainers.image.licenses="GPL-3.0-only AND Apache-2.0 AND MIT"
