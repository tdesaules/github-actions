FROM docker.io/library/docker:29.9.3-cli@sha256:5a7af0dcb0e46c803efe9b45371dd21cb500e5b4453250394ac6f06d49b6e6f1 AS docker-cli
FROM quay.io/fedora/fedora:45 AS build
# hadolint ignore=DL3041
RUN dnf install -y --setopt=install_weak_deps=False golang-1.27.4-2.fc45 curl ca-certificates && dnf clean all
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY go.mod go.sum ./
COPY workflow/build-atomic-image/ ./workflow/build-atomic-image/
RUN CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /entrypoint ./workflow/build-atomic-image
# The upstream CLI donor omits license files. Fetch them from the exact source
# commits reported by these pinned binaries and verify the observed bytes.
RUN mkdir -p /licenses/docker-cli /licenses/buildx \
    && curl --fail --location --retry 3 https://raw.githubusercontent.com/docker/cli/5457199aa57c45e990c59c89cab5f02b817238d7/LICENSE -o /licenses/docker-cli/LICENSE \
    && curl --fail --location --retry 3 https://raw.githubusercontent.com/docker/cli/5457199aa57c45e990c59c89cab5f02b817238d7/NOTICE -o /licenses/docker-cli/NOTICE \
    && curl --fail --location --retry 3 https://raw.githubusercontent.com/docker/buildx/360040a78d6113dc84e5d4dcdf0f438e1be7a41f/LICENSE -o /licenses/buildx/LICENSE \
    && printf '%s\n' \
    '2d81ea060825006fc8f3fe28aa5dc0ffeb80faf325b612c955229157b8c10dc0  /licenses/docker-cli/LICENSE' \
    'a8c869fbda819afb8d80e0ac19bac52e766bc6c19cb38cf94f52d64c4be2aab6  /licenses/docker-cli/NOTICE' \
    'cfc7749b96f63bd31c3c42b5c471bf756814053e847c10f3eb003417bc523d30  /licenses/buildx/LICENSE' \
    > /licenses/SHA256SUMS \
    && sha256sum -c /licenses/SHA256SUMS
FROM quay.io/fedora/fedora:45 AS final
COPY --from=build /entrypoint /entrypoint
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/docker-buildx /usr/local/libexec/docker/cli-plugins/docker-buildx
COPY --from=build /licenses/ /usr/share/licenses/
COPY LICENSE /usr/share/licenses/github-actions/LICENSE
# The native action uses the runner socket under the narrowly approved Atomic
# construction exception. The action container itself needs no privileged flag.
# hadolint ignore=DL3002
USER 0:0
WORKDIR /github/workspace
ENTRYPOINT ["/entrypoint"]
LABEL org.opencontainers.image.title="workflow-build-atomic-image" org.opencontainers.image.source="https://github.com/tdesaules/github-actions" org.opencontainers.image.licenses="GPL-3.0-only AND Apache-2.0"
