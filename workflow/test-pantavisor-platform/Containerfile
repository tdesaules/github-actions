FROM docker.io/library/golang:1.27.3-alpine3.24@sha256:fa3d596898d9f126af7c01d14ee7597bab3f39cccf392ef36b69fe77cd681f18 AS build
WORKDIR /src
COPY go.mod go.sum ./
COPY shared/workflow/ ./shared/workflow/
COPY shared/pantavisor/ ./shared/pantavisor/
COPY shared/component/ ./shared/component/
COPY workflow/test-pantavisor-platform/main.go ./workflow/test-pantavisor-platform/main.go
RUN CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /entrypoint ./workflow/test-pantavisor-platform
FROM docker.io/library/ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55 AS qemu
ARG DEBIAN_FRONTEND=noninteractive
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends build-essential ca-certificates curl libfdt-dev libglib2.0-dev libpixman-1-dev libslirp-dev ninja-build python3 python3-venv python3-tomli xz-utils && rm -rf /var/lib/apt/lists/*
WORKDIR /src
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN curl -fL https://download.qemu.org/qemu-10.2.2.tar.xz -o qemu.tar.xz \
    && echo '784b296ff29c1417aa72323abcb2d2ea9ab9771724f577dcd785c3b04f21e176  qemu.tar.xz' | sha256sum -c - \
    && tar -xf qemu.tar.xz --strip-components=1 \
    && ./configure --prefix=/opt/qemu --target-list=aarch64-softmmu,aarch64-linux-user --disable-docs --disable-tools --disable-guest-agent --enable-slirp \
    && make -j4 && make install
FROM docker.io/library/ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55 AS tools
ARG DEBIAN_FRONTEND=noninteractive
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends binutils bzip2 ca-certificates cpio e2fsprogs git grub-common gzip kmod openssh-client python3 libfdt1 libglib2.0-0t64 libpixman-1-0 libslirp0 qemu-efi-aarch64 squashfs-tools tar xz-utils zstd && rm -rf /var/lib/apt/lists/*
COPY --from=qemu /opt/qemu /opt/qemu
COPY shared/collect-binaries.sh /collect-binaries.sh
COPY shared/pantavisor/collect-metadata.py /collect-metadata.py
RUN sh /collect-binaries.sh /usr/bin/python3 /usr/bin/git /bin/sh /usr/bin/ar /usr/bin/tar /usr/bin/xz /usr/bin/gzip /usr/bin/bzip2 /usr/bin/zstd /usr/bin/cpio /usr/bin/cp /usr/bin/ssh /usr/bin/ssh-keygen /usr/bin/unsquashfs /usr/bin/grub-mkstandalone /usr/bin/grub-mkimage /usr/bin/grub-script-check /usr/bin/grub-editenv /usr/sbin/mke2fs /usr/sbin/mkfs.ext4 /usr/sbin/e2fsck /usr/sbin/debugfs /usr/sbin/depmod /usr/sbin/modprobe /usr/sbin/modinfo /opt/qemu/bin/qemu-aarch64 /opt/qemu/bin/qemu-system-aarch64 \
    && find /usr/lib/python3.12/lib-dynload -name '*.so' -exec sh /collect-binaries.sh {} + \
    && python3 /collect-metadata.py
FROM scratch AS final
COPY LICENSE /usr/share/licenses/github-actions/LICENSE
COPY --from=qemu /src/COPYING /usr/share/licenses/qemu/COPYING
COPY --from=tools /runtime/ /
COPY --from=tools /usr/lib/python3.12/ /usr/lib/python3.12/
COPY --from=tools /usr/lib/git-core/ /usr/lib/git-core/
COPY --from=tools /usr/share/git-core/ /usr/share/git-core/
COPY --from=tools /usr/share/qemu-efi-aarch64/ /usr/share/qemu-efi-aarch64/
COPY --from=tools /opt/qemu/share/ /opt/qemu/share/
COPY --from=tools /etc/mke2fs.conf /etc/mke2fs.conf
COPY --from=build /entrypoint /entrypoint
COPY workflow/test-pantavisor-platform/qualify.py /opt/pantavisor/qualify.py
ENV PATH=/opt/qemu/bin:/usr/bin:/bin:/usr/sbin HOME=/tmp PYTHONDONTWRITEBYTECODE=1 SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
# Offline filesystem assembly preserves guest ownership; no host mounts/devices.
# hadolint ignore=DL3002
USER 0:0
WORKDIR /github/workspace
ENTRYPOINT ["/entrypoint"]
LABEL org.opencontainers.image.title="workflow-test-pantavisor-platform" org.opencontainers.image.source="https://github.com/tdesaules/github-actions" org.opencontainers.image.licenses="GPL-3.0-only"
