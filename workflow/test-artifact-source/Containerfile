FROM quay.io/fedora/fedora:44@sha256:50ab7dd5a71732975b6a1f19108df021b61254f3a507e68ac8abb5fb0bceb308 AS build
# hadolint ignore=DL3041
RUN dnf install -y golang-1.26.10-1.fc44 git ca-certificates && dnf clean all
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY go.mod go.sum ./
COPY shared/workflow/ ./shared/workflow/
COPY shared/catalog/ ./shared/catalog/
COPY workflow/test-artifact-source/main.go workflow/test-artifact-source/artifacts.go ./workflow/test-artifact-source/
COPY workflow/get-image-matrix/main.go workflow/get-image-matrix/dependencies.go ./workflow/get-image-matrix/
RUN CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /entrypoint ./workflow/test-artifact-source \
    && CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /matrix ./workflow/get-image-matrix \
    && mkdir -p /runtime/tmp && chmod 1777 /runtime/tmp

COPY shared/collect-binaries.sh /collect-binaries.sh
RUN sh /collect-binaries.sh /usr/bin/git
FROM scratch AS final
COPY --from=build /matrix /matrix
COPY LICENSE /usr/share/licenses/github-actions/LICENSE
COPY --from=build /runtime/ /
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /entrypoint /entrypoint
# GitHub owns the mounted output file.
# hadolint ignore=DL3002
USER 0:0
WORKDIR /github/workspace
ENV PATH=/usr/bin HOME=/tmp
ENTRYPOINT ["/entrypoint"]
LABEL org.opencontainers.image.title="workflow-test-artifact-source" org.opencontainers.image.source="https://github.com/tdesaules/github-actions" org.opencontainers.image.licenses="GPL-3.0-only"
