FROM docker.io/library/golang:1.27.2-alpine3.24@sha256:f92b6ef800e499660581efdabdf25d9d817a9d124eaf900924f0504e7e27e12d AS build
WORKDIR /src
COPY go.mod go.sum ./
COPY shared/catalog/ ./shared/catalog/
COPY shared/publication/ ./shared/publication/
COPY shared/runtime/ ./shared/runtime/
COPY shared/workflow/ ./shared/workflow/
COPY workflow/publish-catalog-images/main.go ./workflow/publish-catalog-images/main.go
RUN CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /entrypoint ./workflow/publish-catalog-images
FROM ghcr.io/tdesaules/github-actions/workflow-get-image-matrix@sha256:221d845a4d3c26bcd3a534b0800a4995f7f8acb60ba1097876dd214c4f241886 AS git
FROM ghcr.io/tdesaules/github-actions/oci-import-image@sha256:172b727c3989d17cec77a430a98c1211a254240f31d87747a911871cfde67322 AS registry
FROM build AS patched-skopeo
RUN sh shared/runtime/compile-skopeo.sh
FROM scratch AS final
COPY --from=git / /
COPY --from=registry /usr/bin/skopeo /usr/bin/skopeo
COPY --from=registry /etc/containers/ /etc/containers/
COPY --from=registry /var/ /var/
COPY --from=registry /run/ /run/
COPY --from=patched-skopeo /tool /usr/bin/skopeo
COPY --from=build /entrypoint /entrypoint
ENV PATH=/usr/bin HOME=/tmp
# Writes the publication journal in the runner workspace.
# hadolint ignore=DL3002
USER 0:0
WORKDIR /github/workspace
ENTRYPOINT ["/entrypoint"]
LABEL org.opencontainers.image.title="workflow-publish-catalog-images" org.opencontainers.image.source="https://github.com/tdesaules/github-actions" org.opencontainers.image.licenses="GPL-3.0-only AND Apache-2.0"
