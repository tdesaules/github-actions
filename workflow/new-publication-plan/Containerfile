FROM docker.io/library/golang:1.27.3-alpine3.24@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb AS build
WORKDIR /src
COPY go.mod go.sum ./
COPY shared/catalog/ ./shared/catalog/
COPY shared/publication/ ./shared/publication/
COPY shared/runtime/ ./shared/runtime/
COPY shared/workflow/ ./shared/workflow/
COPY workflow/new-publication-plan/main.go ./workflow/new-publication-plan/main.go
COPY workflow/get-image-matrix/main.go workflow/get-image-matrix/dependencies.go ./workflow/get-image-matrix/
RUN CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /entrypoint ./workflow/new-publication-plan \
    && CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /matrix ./workflow/get-image-matrix
FROM ghcr.io/tdesaules/github-actions/workflow-get-image-matrix@sha256:221d845a4d3c26bcd3a534b0800a4995f7f8acb60ba1097876dd214c4f241886 AS git
FROM ghcr.io/tdesaules/github-actions/oci-import-image@sha256:172b727c3989d17cec77a430a98c1211a254240f31d87747a911871cfde67322 AS registry
FROM scratch AS final
COPY --from=git / /
COPY --from=build /matrix /matrix
COPY --from=registry /usr/bin/skopeo /usr/bin/skopeo
COPY --from=registry /etc/containers/ /etc/containers/
COPY --from=registry /var/ /var/
COPY --from=registry /run/ /run/
COPY --from=build /entrypoint /entrypoint
ENV PATH=/usr/bin HOME=/tmp
# Writes publication plans in the runner workspace.
# hadolint ignore=DL3002
USER 0:0
WORKDIR /github/workspace
ENTRYPOINT ["/entrypoint"]
LABEL org.opencontainers.image.title="workflow-new-publication-plan" org.opencontainers.image.source="https://github.com/tdesaules/github-actions" org.opencontainers.image.licenses="GPL-3.0-only AND Apache-2.0"
