FROM docker.io/library/golang:1.27.3-alpine3.24@sha256:fa3d596898d9f126af7c01d14ee7597bab3f39cccf392ef36b69fe77cd681f18 AS build
WORKDIR /src
COPY go.mod go.sum ./
COPY shared/workflow/ ./shared/workflow/
COPY shared/component/ ./shared/component/
COPY shared/pantavisor/ ./shared/pantavisor/
COPY workflow/read-pantavisor-release/main.go ./workflow/read-pantavisor-release/main.go
RUN CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /entrypoint ./workflow/read-pantavisor-release \
    && apk add --no-cache git=2.54.1-r0
COPY shared/collect-binaries.sh /collect-binaries.sh
RUN sh /collect-binaries.sh /usr/bin/git /bin/sh /usr/libexec/git-core/git-remote-http
FROM scratch AS final
COPY LICENSE /usr/share/licenses/github-actions/LICENSE
COPY --from=build /runtime/ /
COPY --from=build /usr/libexec/git-core/ /usr/libexec/git-core/
COPY --from=build /usr/share/git-core/ /usr/share/git-core/
COPY --from=build /entrypoint /entrypoint
ENV PATH=/usr/bin:/bin HOME=/tmp
# Writes only GITHUB_OUTPUT; Git and HTTPS reads validate the source run.
# hadolint ignore=DL3002
USER 0:0
WORKDIR /github/workspace
ENTRYPOINT ["/entrypoint"]
LABEL org.opencontainers.image.title="workflow-read-pantavisor-release" org.opencontainers.image.source="https://github.com/tdesaules/github-actions" org.opencontainers.image.licenses="GPL-3.0-only"
