FROM docker.io/library/golang:1.27.2-alpine3.24@sha256:f92b6ef800e499660581efdabdf25d9d817a9d124eaf900924f0504e7e27e12d AS build
SHELL ["/bin/ash", "-eo", "pipefail", "-c"]
WORKDIR /src
COPY go.mod go.sum ./
COPY shared/plan/ ./shared/plan/
COPY workflow/get-execution-plan/main.go ./workflow/get-execution-plan/main.go
RUN CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /entrypoint ./workflow/get-execution-plan
RUN apk add --no-cache git=2.54.0-r0 \
    && mkdir -p /runtime/usr/bin /runtime/tmp && chmod 1777 /runtime/tmp \
    && cp /usr/bin/git /runtime/usr/bin/git \
    && ldd /usr/bin/git | awk '{for (i=1;i<=NF;i++) if ($i ~ /^\//) print $i}' > /libraries \
    && while read -r library; do mkdir -p "/runtime$(dirname "$library")"; cp -L "$library" "/runtime$library"; done < /libraries

FROM scratch AS final
COPY LICENSE /usr/share/licenses/github-actions/LICENSE
COPY --from=build /entrypoint /entrypoint
COPY --from=build /runtime/ /
ENV PATH=/usr/bin HOME=/tmp
# GitHub owns the mounted output file; this operation only reads repository data.
# hadolint ignore=DL3002
USER 0:0
WORKDIR /github/workspace
ENTRYPOINT ["/entrypoint"]
LABEL org.opencontainers.image.title="workflow-get-execution-plan" org.opencontainers.image.source="https://github.com/tdesaules/github-actions" org.opencontainers.image.licenses="GPL-3.0-only AND GPL-2.0-only"
