FROM docker.io/library/golang:1.27.3-alpine3.24@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb AS build
WORKDIR /src
COPY go.mod go.sum ./
COPY shared/catalog/ ./shared/catalog/
COPY shared/publication/ ./shared/publication/
COPY shared/runtime/ ./shared/runtime/
COPY shared/workflow/ ./shared/workflow/
COPY workflow/new-catalog-signatures/main.go ./workflow/new-catalog-signatures/main.go
RUN CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /entrypoint ./workflow/new-catalog-signatures
FROM ghcr.io/tdesaules/github-actions/workflow-get-image-matrix@sha256:221d845a4d3c26bcd3a534b0800a4995f7f8acb60ba1097876dd214c4f241886 AS git
FROM ghcr.io/tdesaules/github-actions/oci-new-image-signature@sha256:189e5b85f622b0d40d784a2ce739bbe6711dba4d4921abdd7d1240a2371b3882 AS signer
FROM scratch AS final
COPY --from=git / /
COPY --from=signer /usr/bin/cosign /usr/bin/cosign
COPY --from=build /entrypoint /entrypoint
ENV PATH=/usr/bin HOME=/tmp
# Registry credentials are ephemeral and outputs belong to the runner.
# hadolint ignore=DL3002
USER 0:0
WORKDIR /github/workspace
ENTRYPOINT ["/entrypoint"]
LABEL org.opencontainers.image.title="workflow-new-catalog-signatures" org.opencontainers.image.source="https://github.com/tdesaules/github-actions" org.opencontainers.image.licenses="GPL-3.0-only AND Apache-2.0"
