Backport the descriptor-lifetime portion of upstream commit
286dd3ff41526b582ef48830de239dffbaa61f90 to util-linux 2.41.6.
The stable release already includes O_CLOEXEC; close the authority-bearing
descriptor immediately after migration as well (CVE-2026-78408).
Include the file-resolution declarations in the stable idmap hook and use
the Linux UAPI value for RESOLVE_NO_SYMLINKS in the fallback definition.

--- a/sys-utils/nsenter.c
+++ b/sys-utils/nsenter.c
@@ -379,13 +379,15 @@
 static void open_cgroup_procs(void)
 {
 	char *buf = NULL, *path = NULL, *p;
-	int cgroup_fd = 0;
+	int cgroup_fd = -1;
 	char fdpath[PATH_MAX];
 
 	open_target_fd(&cgroup_fd, "cgroup", optarg);
 
 	if (read_all_alloc(cgroup_fd, &buf) < 1)
 		err(EXIT_FAILURE, _("failed to get cgroup path"));
+
+	close(cgroup_fd);
 
 	p = strtok(buf, "\n");
 	if (p)
@@ -816,8 +818,11 @@
 	}
 
 	// Join into the target cgroup
-	if (cgroup_procs_fd >= 0)
+	if (cgroup_procs_fd >= 0) {
 		join_into_cgroup();
+		close(cgroup_procs_fd);
+		cgroup_procs_fd = -1;
+	}
 
 	if (uid_gid_fd >= 0) {
 		struct stat st;
