    libnghttp3-dev=1.15.0-1~bpo13+1 \
    libngtcp2-16=1.22.1-1~bpo13+1 \
    libngtcp2-crypto-gnutls8=1.22.1-1~bpo13+1 \
    libngtcp2-crypto-gnutls-dev=1.22.1-1~bpo13+1 \
    libngtcp2-crypto-ossl-dev=1.22.1-1~bpo13+1 \
