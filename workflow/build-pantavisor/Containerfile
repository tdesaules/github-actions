RUN apt-get update && apt-get install -y --no-install-recommends \
    dh-sequence-builtusing gpgrt-tools libassuan-dev libbz2-dev libgcrypt20-dev \
    libgnutls28-dev libgpg-error-dev libksba-dev libldap2-dev libnpth0-dev \
    libreadline-dev libsqlite3-dev libtss2-dev libusb-1.0-0-dev openssh-client \
    swtpm unicode-data zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*
RUN DEB_BUILD_PROFILES=nodoc sh /build-debian-library.sh \
    https://deb.debian.org/debian/pool/main/g/gnupg2/gnupg2_2.4.9.orig.tar.bz2 \
    dd17ab2e9a04fd79d39d853f599cbc852062ddb9ab52a4ddeb4176fd8b302964 \
    https://deb.debian.org/debian/pool/main/g/gnupg2/gnupg2_2.4.9-8.debian.tar.xz \
    69e954dc52f1a674bf567aa40064e24ca230210394975a6cddf98742e2a6f882 \
    gpg gpg-agent gpgconf gpgsm gpgv dirmngr gnupg-utils
WORKDIR /backport-source/source
# Build the matching architecture-independent packages from the already built
# native tree, without pulling in unrelated Windows cross-build dependencies.
RUN export DEB_BUILD_PROFILES=nodoc; \
    for command in dh_install dh_installdocs dh_installchangelogs dh_compress dh_fixperms dh_installdeb dh_gencontrol dh_md5sums dh_builddeb; do \
        "$command" -pgnupg -pgnupg-l10n || exit; \
    done; \
    cp ../gnupg_2.4.9-8~pantavisor1_all.deb ../gnupg-l10n_2.4.9-8~pantavisor1_all.deb /packages/
