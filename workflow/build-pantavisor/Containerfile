FROM quay.io/fedora/fedora:45@sha256:3632de47c2cef45d6a6ea6a420280ff9ce452e225a1b291299c105b9d9bae471 AS build
# Distribution-maintained compiler; no system compiler/library source builds.
# Resolve supporting RPMs from signed Fedora repositories; promote exact archives.
# hadolint ignore=DL3041
RUN dnf install -y golang-1.27.3-1.fc45 git && dnf clean all
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY go.mod go.sum ./
COPY shared/workflow/ ./shared/workflow/
COPY shared/pantavisor/ ./shared/pantavisor/
COPY shared/component/ ./shared/component/
COPY workflow/build-pantavisor/main.go ./workflow/build-pantavisor/main.go
RUN CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /entrypoint ./workflow/build-pantavisor

FROM build AS git-lfs
WORKDIR /lfs
RUN go mod init github.com/tdesaules/git-lfs-build \
    && go mod edit -require=github.com/git-lfs/git-lfs/v3@v3.8.1 \
    && go mod download -json github.com/git-lfs/git-lfs/v3@v3.8.1 > /source.json \
    && grep -F '"Sum": "h1:SzfllBjlYuSaswBmhUeDPGgXSA74aIQ3/QHxbZmyyfM="' /source.json \
    && go mod edit -require=golang.org/x/crypto@v0.56.0 -require=golang.org/x/net@v0.60.0 -require=github.com/klauspost/compress@v1.20.2 \
    && CGO_ENABLED=0 go build -mod=mod -trimpath -ldflags='-s -w' -o /git-lfs github.com/git-lfs/git-lfs/v3 \
    && cp /root/go/pkg/mod/github.com/git-lfs/git-lfs/v3@v3.8.1/LICENSE.md /LICENSE.md

FROM quay.io/fedora/fedora:45@sha256:3632de47c2cef45d6a6ea6a420280ff9ce452e225a1b291299c105b9d9bae471 AS final
COPY workflow/build-pantavisor/requirements.txt /opt/pantavisor/requirements.txt
# A Yocto builder needs a full shell/toolchain environment. Keep RPM metadata and
# dependency management instead of reconstructing a distribution inside scratch.
# Python 3.13 matches our qualified BitBake baseline rather than Fedora's default.
# Security updates are resolved at build time and recorded in the image's RPM DB.
# hadolint ignore=DL3041
RUN dnf upgrade -y --refresh \
    && dnf install -y --setopt=install_weak_deps=False \
    bash bzip2 ca-certificates catatonit-0.2.1-6.fc45 chrpath cpio curl-8.21.0-9.fc45 diffstat diffutils file findutils \
    gawk gcc gcc-c++ git glibc-langpack-en gzip hostname lz4 make patch \
    perl perl-Data-Dumper perl-File-Compare perl-File-Copy perl-FindBin perl-Thread-Queue \
    pigz pkgconf-pkg-config procps-ng python3.13 rpcgen rsync socat tar texinfo \
    unzip util-linux wget which xz zstd \
    && dnf clean all \
    && test -x /usr/libexec/catatonit/catatonit \
    && python3.13 -m venv /opt/kas \
    && /opt/kas/bin/pip install --no-cache-dir --only-binary=:all: --upgrade pip==26.2.0 \
    && /opt/kas/bin/pip install --no-cache-dir --only-binary=:all: -r /opt/pantavisor/requirements.txt \
    && mkdir -p /github/workspace /var/tmp \
    && chmod 1777 /tmp /var/tmp
COPY LICENSE /usr/share/licenses/github-actions/LICENSE
COPY --from=build /entrypoint /entrypoint
COPY --from=git-lfs /git-lfs /usr/bin/git-lfs
COPY --from=git-lfs /LICENSE.md /usr/share/licenses/git-lfs/LICENSE.md
COPY workflow/build-pantavisor/build.py /opt/pantavisor/build.py
COPY workflow/build-pantavisor/build_config.py /opt/pantavisor/build_config.py
ENV PATH=/opt/kas/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin LANG=en_US.UTF-8 PYTHONDONTWRITEBYTECODE=1 SSL_CERT_FILE=/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem
# Creates the /work alias, then drops to the checkout owner's non-root UID.
# hadolint ignore=DL3002
USER 0:0
WORKDIR /github/workspace
ENTRYPOINT ["/entrypoint"]
LABEL org.opencontainers.image.title="workflow-build-pantavisor" org.opencontainers.image.source="https://github.com/tdesaules/github-actions" org.opencontainers.image.licenses="GPL-3.0-only"
