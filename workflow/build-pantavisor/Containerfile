COPY workflow/build-pantavisor/wget-bounds.patch /wget-bounds.patch
COPY workflow/build-pantavisor/test-wget-bounds.py /test-wget-bounds.py
RUN BACKPORT_SUFFIX=+pantavisor1 \
    SECURITY_PATCH_URL=https://gitlab.com/gnuwget/wget/-/commit/c2640fe5171c59f87c58dc9fcb195b2d18b010ee.patch \
    SECURITY_PATCH_SHA256=1cf705d8020435be06fe8daca1ab3dfa8cd2bc93937b613dfb1c49d56135878e \
    LOCAL_SECURITY_PATCH=/wget-bounds.patch \
    LOCAL_SECURITY_PATCH_SHA256=245918fddf2563093654a4080691334f69b49696ebf5390a01d471054dcaea8d \
    sh /build-debian-library.sh \
    https://deb.debian.org/debian/pool/main/w/wget/wget_1.25.0.orig.tar.gz \
    766e48423e79359ea31e41db9e5c289675947a7fcf2efdcedb726ac9d0da3784 \
    https://deb.debian.org/debian/pool/main/w/wget/wget_1.25.0-2.debian.tar.xz \
    45d4411e892d12af710ddff536d2daf430031387e336153f5f996cf536487b90 \
    wget \
    && python3 /test-wget-bounds.py
FROM tools-base AS tools
COPY --from=curl-build /packages/ /packages/
COPY --from=python-build /packages/ /packages/
