FROM quay.io/fedora/fedora:44@sha256:50ab7dd5a71732975b6a1f19108df021b61254f3a507e68ac8abb5fb0bceb308 AS build
# Supporting RPMs follow the signed Fedora repository; the Go compiler is pinned.
# hadolint ignore=DL3041
RUN dnf install -y golang-1.26.10-1.fc44 git ca-certificates && dnf clean all
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY go.mod go.sum ./
COPY shared/catalog/ ./shared/catalog/
COPY shared/workflow/ ./shared/workflow/
COPY workflow/test-reviewed-vulnerabilities/main.go ./workflow/test-reviewed-vulnerabilities/main.go
RUN CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /entrypoint ./workflow/test-reviewed-vulnerabilities
FROM build AS patched-grype
COPY shared/runtime/ ./shared/runtime/
RUN sh shared/runtime/compile-grype.sh
FROM scratch AS final
COPY LICENSE /usr/share/licenses/github-actions/LICENSE
COPY --from=patched-grype /runtime/ /
COPY --from=patched-grype /tool-source/LICENSE /usr/share/licenses/grype/LICENSE
COPY --from=build /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem /etc/ssl/certs/ca-certificates.crt
COPY --from=patched-grype /tool /usr/bin/grype
COPY --from=build /entrypoint /entrypoint
ENV PATH=/usr/bin HOME=/tmp
# Writes candidate reports into the runner workspace.
# hadolint ignore=DL3002
USER 0:0
WORKDIR /github/workspace
ENTRYPOINT ["/entrypoint"]
LABEL org.opencontainers.image.title="workflow-test-reviewed-vulnerabilities" org.opencontainers.image.source="https://github.com/tdesaules/github-actions" org.opencontainers.image.licenses="GPL-3.0-only AND Apache-2.0"
