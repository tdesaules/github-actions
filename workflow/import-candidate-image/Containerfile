FROM docker.io/library/golang:1.27.3-alpine3.24@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb AS build
WORKDIR /src
COPY go.mod go.sum ./
COPY workflow/import-candidate-image/main.go ./workflow/import-candidate-image/main.go
RUN CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /entrypoint ./workflow/import-candidate-image

FROM build AS tool
COPY shared/runtime/compile-tool.sh /compile-tool.sh
RUN BUILDTAGS=containers_image_openpgp,exclude_graphdriver_btrfs,exclude_graphdriver_devicemapper sh /compile-tool.sh github.com/containers/skopeo v1.22.3 h1:r85TJYmaMhSgmtuPWxrsPQgaWL/+Q3y/cLLGE/DXjlc= skopeo golang.org/x/net@v0.60.0 golang.org/x/crypto@v0.56.0 golang.org/x/text@v0.41.0 google.golang.org/grpc@v1.83.2 go.opentelemetry.io/otel@v1.41.0 github.com/opencontainers/selinux@v1.13.0 github.com/sigstore/fulcio@v1.8.6

FROM ghcr.io/tdesaules/github-actions/oci-import-image@sha256:11f4439932710275ca5ffce92e71eef3680e09907c99c2eb0b83dfd32ebbdba1 AS runtime

FROM scratch AS final
COPY LICENSE /usr/share/licenses/github-actions/LICENSE
COPY --from=runtime /etc/ /etc/
COPY --from=tool /runtime/ /
COPY --from=runtime /var/ /var/
COPY --from=runtime /run/ /run/
COPY --from=tool /tool /usr/bin/skopeo
COPY --from=build /entrypoint /entrypoint
ENV PATH=/usr/bin HOME=/tmp
# GitHub owns the output file mounted into this action.
# hadolint ignore=DL3002
USER 0:0
WORKDIR /github/workspace
ENTRYPOINT ["/entrypoint"]
LABEL org.opencontainers.image.title="workflow-import-candidate-image" org.opencontainers.image.source="https://github.com/tdesaules/github-actions" org.opencontainers.image.licenses="GPL-3.0-only AND Apache-2.0"
