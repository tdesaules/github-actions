FROM quay.io/fedora/fedora:44@sha256:b3e011d47e686a89781495c9a87bc80349af742965e5d51e79cd51711982e4a2 AS build
RUN dnf install -y golang-1.26.10-1.fc44 && dnf clean all
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY go.mod go.sum ./
COPY shared/candidate/ ./shared/candidate/
COPY shared/catalog/ ./shared/catalog/
COPY shared/fixtures/ ./shared/fixtures/
COPY shared/workflow/ ./shared/workflow/
COPY workflow/test-candidate-runtime/ ./workflow/test-candidate-runtime/
RUN CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /entrypoint ./workflow/test-candidate-runtime \
    && echo 'disposable-candidate-runtime' > /candidate-runtime-marker
FROM quay.io/fedora/fedora:44@sha256:b3e011d47e686a89781495c9a87bc80349af742965e5d51e79cd51711982e4a2 AS final
# Skopeo's distribution policy, trust store and transport libraries are retained.
# hadolint ignore=DL3041
RUN dnf install -y skopeo git ca-certificates && dnf clean all
COPY LICENSE /usr/share/licenses/github-actions/LICENSE
COPY --from=build /entrypoint /entrypoint
COPY --from=build /candidate-runtime-marker /.candidate-runtime
ENV PATH=/usr/bin HOME=/tmp
# Installs the candidate in this disposable container, then runs it as UID/GID 65532.
# No engine socket, privileged mode or additional capabilities are requested.
# hadolint ignore=DL3002
USER 0:0
WORKDIR /github/workspace
ENTRYPOINT ["/entrypoint"]
LABEL org.opencontainers.image.title="workflow-test-candidate-runtime" org.opencontainers.image.source="https://github.com/tdesaules/github-actions" org.opencontainers.image.licenses="GPL-3.0-only AND Apache-2.0"
