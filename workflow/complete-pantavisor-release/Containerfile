FROM docker.io/library/golang:1.27.4-alpine3.24@sha256:0a5f7fe796599ff487605987432e7619ae45beeb2fba4c2ce0b907879932aebf AS build
WORKDIR /src
COPY go.mod go.sum ./
COPY shared/workflow/ ./shared/workflow/
COPY shared/component/ ./shared/component/
COPY shared/pantavisor/ ./shared/pantavisor/
COPY workflow/complete-pantavisor-release/main.go ./workflow/complete-pantavisor-release/main.go
RUN CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /entrypoint ./workflow/complete-pantavisor-release \
    && apk add --no-cache git=2.54.1-r0
COPY shared/collect-binaries.sh /collect-binaries.sh
RUN sh /collect-binaries.sh /usr/bin/git /bin/sh /usr/libexec/git-core/git-remote-http
FROM scratch AS final
COPY LICENSE /usr/share/licenses/github-actions/LICENSE
COPY --from=build /runtime/ /
COPY --from=build /usr/libexec/git-core/ /usr/libexec/git-core/
COPY --from=build /usr/share/git-core/ /usr/share/git-core/
COPY --from=build /entrypoint /entrypoint
ENV PATH=/usr/bin:/bin HOME=/tmp
# Creates the annotated tag; authentication is child-environment-only.
# hadolint ignore=DL3002
USER 0:0
WORKDIR /github/workspace
ENTRYPOINT ["/entrypoint"]
LABEL org.opencontainers.image.title="workflow-complete-pantavisor-release" org.opencontainers.image.source="https://github.com/tdesaules/github-actions" org.opencontainers.image.licenses="GPL-3.0-only"
