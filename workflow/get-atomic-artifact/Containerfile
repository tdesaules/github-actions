FROM docker.io/library/golang:1.27.4-alpine3.24@sha256:70bd7ddea8b6cbe5d6943cde279d6b67feb10cc924fb9100d1d8757c1575b280 AS build
WORKDIR /src
COPY go.mod go.sum ./
COPY workflow/get-atomic-artifact/ ./workflow/get-atomic-artifact/
RUN CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /entrypoint ./workflow/get-atomic-artifact \
    && mkdir -p /runtime/tmp && chmod 1777 /runtime/tmp
FROM scratch AS final
COPY --from=build /runtime/ /
COPY --from=build /entrypoint /entrypoint
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY LICENSE /usr/share/licenses/github-actions/LICENSE
# Writes the runner-owned GITHUB_OUTPUT file.
# hadolint ignore=DL3002
USER 0:0
WORKDIR /github/workspace
ENTRYPOINT ["/entrypoint"]
LABEL org.opencontainers.image.title="workflow-get-atomic-artifact" org.opencontainers.image.source="https://github.com/tdesaules/github-actions" org.opencontainers.image.licenses="GPL-3.0-only"
