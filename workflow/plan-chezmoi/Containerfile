FROM quay.io/fedora/fedora:45 AS build
# hadolint ignore=DL3041
RUN dnf install -y golang-1.27.4-2.fc45 curl tar gzip && dnf clean all
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY go.mod go.sum ./
COPY shared/workflow/ ./shared/workflow/
COPY shared/chezmoi/ ./shared/chezmoi/
COPY workflow/plan-chezmoi/main.go ./workflow/plan-chezmoi/main.go
RUN CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /entrypoint ./workflow/plan-chezmoi
RUN case "$(uname -m)" in \
    x86_64) target=x86_64; sum=fa21e2fc70046fcfd0e43e5e4613873ab799aff3d9dc8559c00d31b270e417d0 ;; \
    aarch64) target=aarch64; sum=4be21b21ec9699af4d330b224aeba8a41d41d8f5b351ca2da8a9ea2bdc36380f ;; \
    *) exit 1 ;; esac \
    && curl --fail --location --retry 3 "https://github.com/orhun/git-cliff/releases/download/v2.14.2/git-cliff-2.14.2-${target}-unknown-linux-musl.tar.gz" -o /tmp/cliff.tar.gz \
    && printf '%s  /tmp/cliff.tar.gz\n' "$sum" > /tmp/cliff.sha256 \
    && sha256sum -c /tmp/cliff.sha256 \
    && mkdir /cliff && tar -xzf /tmp/cliff.tar.gz --strip-components=1 -C /cliff

FROM quay.io/fedora/fedora:45 AS final
# hadolint ignore=DL3041
RUN dnf install -y --setopt=install_weak_deps=False python3 git libgcc ca-certificates && dnf clean all
COPY --from=build /cliff/git-cliff /usr/local/bin/git-cliff
COPY --from=build /cliff/LICENSE-APACHE /usr/share/licenses/git-cliff/LICENSE-APACHE
COPY --from=build /cliff/LICENSE-MIT /usr/share/licenses/git-cliff/LICENSE-MIT
RUN git-cliff --version
ENV PYTHONDONTWRITEBYTECODE=1
COPY LICENSE /usr/share/licenses/github-actions/LICENSE
COPY --from=build /entrypoint /entrypoint
WORKDIR /github/workspace
ENTRYPOINT ["/entrypoint"]
LABEL org.opencontainers.image.title="workflow-plan-chezmoi" org.opencontainers.image.source="https://github.com/tdesaules/github-actions" org.opencontainers.image.licenses="GPL-3.0-only AND Apache-2.0 AND MIT"
