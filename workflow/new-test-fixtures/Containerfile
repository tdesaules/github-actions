FROM quay.io/fedora/fedora:44@sha256:b3e011d47e686a89781495c9a87bc80349af742965e5d51e79cd51711982e4a2 AS build
# Supporting RPMs follow signed Fedora updates; qualified archives stay unchanged.
# hadolint ignore=DL3041
RUN dnf install -y golang-1.26.10-1.fc44 git ca-certificates && dnf clean all
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY go.mod go.sum ./
COPY shared/fixtures/ ./shared/fixtures/
COPY workflow/new-test-fixtures/fail/ ./workflow/new-test-fixtures/fail/
COPY workflow/new-test-fixtures/success/ ./workflow/new-test-fixtures/success/
COPY workflow/new-test-fixtures/main.go ./workflow/new-test-fixtures/main.go
RUN CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /entrypoint ./workflow/new-test-fixtures \
    && CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /fixture-fail-run ./workflow/new-test-fixtures/fail \
    && CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /fixture-success-run ./workflow/new-test-fixtures/success
RUN mkdir -p /runtime/tmp && chmod 1777 /runtime/tmp
COPY shared/collect-binaries.sh /collect-binaries.sh
RUN sh /collect-binaries.sh /usr/bin/git

FROM scratch AS final
COPY LICENSE /usr/share/licenses/github-actions/LICENSE
COPY --from=build /runtime/ /
COPY --from=build /entrypoint /entrypoint
COPY --from=build /fixture-fail-run /fixture-fail-run
COPY --from=build /fixture-success-run /fixture-success-run
ENV PATH=/usr/bin HOME=/tmp
# Generates fixtures in the runner workspace.
# hadolint ignore=DL3002
USER 0:0
WORKDIR /github/workspace
ENTRYPOINT ["/entrypoint"]
LABEL org.opencontainers.image.title="workflow-new-test-fixtures" org.opencontainers.image.source="https://github.com/tdesaules/github-actions" org.opencontainers.image.licenses="GPL-3.0-only"
