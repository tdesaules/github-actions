FROM quay.io/fedora/fedora:44@sha256:526646a990bb8442f936827d98253677dd7a4c28fad33f938e32c7ffdadb72c1 AS build
# hadolint ignore=DL3041
RUN dnf install -y golang-1.26.10-1.fc44 && dnf clean all
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY go.mod go.sum ./
COPY shared/binaryrelease/ ./shared/binaryrelease/
COPY workflow/publish-binary-release/main.go ./workflow/publish-binary-release/main.go
RUN CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /entrypoint ./workflow/publish-binary-release
FROM quay.io/fedora/fedora:44@sha256:526646a990bb8442f936827d98253677dd7a4c28fad33f938e32c7ffdadb72c1 AS final
# Git verifies source/tag metadata before publishing actual archive bytes.
# hadolint ignore=DL3041
RUN dnf install -y --setopt=install_weak_deps=False git ca-certificates && dnf clean all
COPY LICENSE /usr/share/licenses/github-actions/LICENSE
COPY --from=build /entrypoint /entrypoint
ENV PATH=/usr/local/bin:/usr/bin:/bin HOME=/tmp GIT_TERMINAL_PROMPT=0
# Reads mounted qualification artifacts and writes GitHub outputs.
# hadolint ignore=DL3002
USER 0:0
WORKDIR /github/workspace
ENTRYPOINT ["/entrypoint"]
LABEL org.opencontainers.image.title="workflow-publish-binary-release" org.opencontainers.image.source="https://github.com/tdesaules/github-actions" org.opencontainers.image.licenses="GPL-3.0-only"
