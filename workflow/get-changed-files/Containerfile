FROM docker.io/library/golang:1.27.3-alpine3.24@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb AS build
WORKDIR /src
COPY go.mod go.sum ./
COPY shared/workflow/ ./shared/workflow/
COPY workflow/get-changed-files/main.go ./workflow/get-changed-files/main.go
RUN CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /entrypoint ./workflow/get-changed-files \
    && apk add --no-cache git=2.54.0-r0
COPY shared/collect-binaries.sh /collect-binaries.sh
RUN sh /collect-binaries.sh /usr/bin/git

FROM scratch AS final
COPY LICENSE /usr/share/licenses/github-actions/LICENSE
COPY --from=build /runtime/ /
COPY --from=build /entrypoint /entrypoint
ENV PATH=/usr/bin HOME=/tmp
# GitHub owns the mounted output file.
# hadolint ignore=DL3002
USER 0:0
WORKDIR /github/workspace
ENTRYPOINT ["/entrypoint"]
LABEL org.opencontainers.image.title="workflow-get-changed-files" org.opencontainers.image.source="https://github.com/tdesaules/github-actions" org.opencontainers.image.licenses="GPL-3.0-only"
