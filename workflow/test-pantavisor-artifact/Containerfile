FROM docker.io/library/golang:1.27.3-alpine3.24@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb AS build
WORKDIR /src
COPY go.mod go.sum ./
COPY shared/workflow/ ./shared/workflow/
COPY shared/component/ ./shared/component/
COPY shared/pantavisor/ ./shared/pantavisor/
COPY workflow/test-pantavisor-artifact/main.go ./workflow/test-pantavisor-artifact/main.go
RUN CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /entrypoint ./workflow/test-pantavisor-artifact
RUN mkdir -p /runtime/tmp && chmod 1777 /runtime/tmp
FROM scratch AS final
COPY --from=build /runtime/ /
COPY LICENSE /usr/share/licenses/github-actions/LICENSE
COPY --from=build /entrypoint /entrypoint
# Writes only GITHUB_OUTPUT.
# hadolint ignore=DL3002
USER 0:0
WORKDIR /github/workspace
ENTRYPOINT ["/entrypoint"]
LABEL org.opencontainers.image.title="workflow-test-pantavisor-artifact" org.opencontainers.image.source="https://github.com/tdesaules/github-actions" org.opencontainers.image.licenses="GPL-3.0-only"
