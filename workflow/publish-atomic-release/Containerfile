FROM quay.io/fedora/fedora:45 AS build
# hadolint ignore=DL3041
RUN dnf install -y --setopt=install_weak_deps=False golang-1.27.4-2.fc45 && dnf clean all
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY go.mod go.sum ./
COPY shared/workflow/ ./shared/workflow/
COPY shared/atomicrelease/ ./shared/atomicrelease/
COPY workflow/publish-atomic-release/ ./workflow/publish-atomic-release/
RUN CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /entrypoint ./workflow/publish-atomic-release
FROM quay.io/fedora/fedora:45 AS final
# Git validates the annotated source-bound release; Go handles registry/API calls.
# hadolint ignore=DL3041
RUN dnf install -y --setopt=install_weak_deps=False git-core ca-certificates && dnf clean all
COPY --from=build /entrypoint /entrypoint
COPY LICENSE /usr/share/licenses/github-actions/LICENSE
ENV HOME=/tmp GIT_TERMINAL_PROMPT=0
WORKDIR /github/workspace
ENTRYPOINT ["/entrypoint"]
LABEL org.opencontainers.image.title="workflow-publish-atomic-release" org.opencontainers.image.source="https://github.com/tdesaules/github-actions" org.opencontainers.image.licenses="GPL-3.0-only"
