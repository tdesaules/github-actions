FROM docker.io/library/golang:1.27.3-alpine3.24@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb AS build
WORKDIR /src
COPY go.mod go.sum ./
COPY shared/workflow/ ./shared/workflow/
COPY workflow/new-release-plan/main.go ./workflow/new-release-plan/main.go
RUN CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /entrypoint ./workflow/new-release-plan \
    && apk add --no-cache git=2.54.0-r0
COPY shared/collect-binaries.sh /collect-binaries.sh
RUN sh /collect-binaries.sh /usr/bin/git

FROM docker.io/orhunp/git-cliff:2.14.2@sha256:1e696a381a1b0366bb6ccbb6bd4e50e73473fda88eab3a757b95e0d0d66c9531 AS cliff
COPY shared/collect-binaries.sh /collect-binaries.sh
RUN sh /collect-binaries.sh /usr/local/bin/git-cliff

FROM scratch AS final
COPY LICENSE /usr/share/licenses/github-actions/LICENSE
COPY --from=cliff /runtime/ /
COPY --from=build /runtime/ /
COPY --from=build /entrypoint /entrypoint
ENV PATH=/usr/local/bin:/usr/bin HOME=/tmp
# Writes the release plan and GitHub outputs in the runner workspace.
# hadolint ignore=DL3002
USER 0:0
WORKDIR /github/workspace
ENTRYPOINT ["/entrypoint"]
LABEL org.opencontainers.image.title="workflow-new-release-plan" org.opencontainers.image.source="https://github.com/tdesaules/github-actions" org.opencontainers.image.licenses="GPL-3.0-only AND Apache-2.0 AND MIT"
