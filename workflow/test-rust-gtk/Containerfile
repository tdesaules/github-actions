FROM quay.io/fedora/fedora:45@sha256:3632de47c2cef45d6a6ea6a420280ff9ce452e225a1b291299c105b9d9bae471 AS build
# hadolint ignore=DL3041
RUN dnf install -y golang-1.27.3-1.fc45 && dnf clean all
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY go.mod go.sum ./
COPY shared/workflow/ ./shared/workflow/
COPY shared/rustgtk/ ./shared/rustgtk/
COPY workflow/test-rust-gtk/main.go ./workflow/test-rust-gtk/main.go
RUN CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /entrypoint ./workflow/test-rust-gtk

FROM quay.io/fedora/fedora:44@sha256:17c99e30075386f9385685a22ad1924e2c22faee5863272c0379c81b80b9d258 AS final
# Native source tests plus real GTK mapping require compiler, compositor and fonts.
# hadolint ignore=DL3041
RUN dnf install -y --setopt=install_weak_deps=False rust-1.99.1-2.fc44 cargo-1.99.1-2.fc44 gcc gtk4-devel pkgconf-pkg-config nodejs22 nodejs22-bin nodejs22-npm nodejs22-npm-bin python3 python3-pyyaml git ca-certificates weston dbus-daemon mesa-dri-drivers google-noto-sans-fonts \
    && dnf clean all
COPY --from=build /entrypoint /entrypoint
COPY LICENSE /usr/share/licenses/github-actions/LICENSE
ENV PYTHONDONTWRITEBYTECODE=1
WORKDIR /github/workspace
ENTRYPOINT ["/entrypoint"]
LABEL org.opencontainers.image.title="workflow-test-rust-gtk" org.opencontainers.image.source="https://github.com/tdesaules/github-actions" org.opencontainers.image.licenses="GPL-3.0-only"
