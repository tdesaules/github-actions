FROM quay.io/fedora/fedora:45@sha256:b174cd5906c712f59a675cc85ea2ca8ff3bcf3643f1a1f3bc4e14dc28bcf1872 AS build
# hadolint ignore=DL3041
RUN dnf install -y --setopt=install_weak_deps=False golang-1.27.4-2.fc45 && dnf clean all
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY go.mod go.sum ./
COPY shared/workflow/ ./shared/workflow/
COPY shared/atomicrelease/ ./shared/atomicrelease/
COPY check/test-atomic-release/ ./check/test-atomic-release/
RUN CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /entrypoint ./check/test-atomic-release
FROM scratch AS final
COPY --from=build /entrypoint /entrypoint
COPY LICENSE /usr/share/licenses/github-actions/LICENSE
WORKDIR /github/workspace
ENTRYPOINT ["/entrypoint"]
LABEL org.opencontainers.image.title="check-test-atomic-release" org.opencontainers.image.source="https://github.com/tdesaules/github-actions" org.opencontainers.image.licenses="GPL-3.0-only"
