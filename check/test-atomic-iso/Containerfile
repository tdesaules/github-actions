FROM quay.io/fedora/fedora:45@sha256:b174cd5906c712f59a675cc85ea2ca8ff3bcf3643f1a1f3bc4e14dc28bcf1872 AS build
# hadolint ignore=DL3041
RUN dnf install -y --setopt=install_weak_deps=False golang && dnf clean all
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY go.mod go.sum ./
COPY shared/workflow/ ./shared/workflow/
COPY check/test-atomic-iso/ ./check/test-atomic-iso/
RUN CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /entrypoint ./check/test-atomic-iso
FROM quay.io/fedora/fedora:45@sha256:b174cd5906c712f59a675cc85ea2ca8ff3bcf3643f1a1f3bc4e14dc28bcf1872 AS final
# ISO and OCI inspection do not require mounts, an engine or privileged mode.
# hadolint ignore=DL3041
RUN dnf install -y --setopt=install_weak_deps=False xorriso isomd5sum skopeo && dnf clean all
COPY --from=build /entrypoint /entrypoint
COPY LICENSE /usr/share/licenses/github-actions/LICENSE
WORKDIR /github/workspace
ENTRYPOINT ["/entrypoint"]
LABEL org.opencontainers.image.title="check-test-atomic-iso" org.opencontainers.image.source="https://github.com/tdesaules/github-actions" org.opencontainers.image.licenses="GPL-3.0-only"
