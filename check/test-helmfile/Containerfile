FROM quay.io/fedora/fedora:45 AS builder
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN dnf install -y golang-1.27.4-2.fc45 && dnf clean all
COPY check/test-helmfile/main.go /src/main.go
RUN CGO_ENABLED=0 go build -trimpath -o /entrypoint /src/main.go
RUN case "$(uname -m)" in \
    x86_64) arch=amd64; karch=x86_64; helm=0403a88ae20913d11b10a2467b50087721fea7581736da6b9d3992f5357fe54b; hf=7d79c6d2099a4819213873164eda23bdbd32f1404fec7a7104d934e5d102596f; ky=06b8f3ca7b5626473be8fb4d343ad54ab84e317142766f72420e7d44b80942e2 ;; \
    aarch64) arch=arm64; karch=arm64; helm=8cf8f66ecbc252ac8f7f06cca68aba88508ddfde3a6a34feb1678ad1694b4f88; hf=e035c0338e31e0a8054ae798280532d32edcfbb7d6c4993e3b2efa2dc40647ce; ky=7d002205369f8ebb8a5570efb6a1bfc4fa02e67ca74d6d8cf2f27783e0e54759 ;; \
    *) exit 1 ;; esac && \
    curl -fsSL --retry 3 "https://get.helm.sh/helm-v4.3.1-linux-${arch}.tar.gz" -o /helm.tgz && \
    curl -fsSL --retry 3 "https://github.com/helmfile/helmfile/releases/download/v1.8.3/helmfile_1.8.3_linux_${arch}.tar.gz" -o /helmfile.tgz && \
    curl -fsSL --retry 3 "https://github.com/kyverno/kyverno/releases/download/v1.20.0/kyverno-cli_v1.20.0_linux_${karch}.tar.gz" -o /kyverno.tgz && \
    printf '%s  %s\n' "$helm" /helm.tgz "$hf" /helmfile.tgz "$ky" /kyverno.tgz | sha256sum -c - && \
    tar -xzf /helm.tgz -C / --strip-components=1 "linux-${arch}/helm" && \
    tar -xzf /helmfile.tgz -C / helmfile && tar -xzf /kyverno.tgz -C / kyverno
FROM quay.io/fedora/fedora:45 AS final
RUN dnf install -y python3-pyyaml-6.0.3-6.fc45 python3-jsonschema-4.26.0-10.fc45 python3-bcrypt-4.3.0-16.fc45 && dnf clean all
COPY --from=builder /helmfile /usr/local/bin/helmfile
COPY --from=builder /kyverno /usr/local/bin/kyverno
COPY --from=builder /helm /usr/local/bin/helm
COPY --from=builder /entrypoint /entrypoint
COPY LICENSE /usr/share/licenses/github-actions/LICENSE
WORKDIR /github/workspace
ENTRYPOINT ["/entrypoint"]
LABEL org.opencontainers.image.title="check-test-helmfile" org.opencontainers.image.source="https://github.com/tdesaules/github-actions" org.opencontainers.image.licenses="GPL-3.0-only AND Apache-2.0 AND MIT"
